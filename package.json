{
  "name": "new-tabnews",
  "version": "1.0.0",
  "description": "A new implementation for tabnews",
  "homepage": "https://github.com/cristianofmc/new-tabnews#readme",
  "bugs": {
    "url": "https://github.com/cristianofmc/new-tabnews/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cristianofmc/new-tabnews.git"
  },
  "license": "MIT",
  "author": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "postdev": "npm run services:stop",
    "test": "npm run services:up && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"jest --runInBand --verbose\"",
    "posttest": "npm run services:stop",
    "test:watch": "jest --watch --runInBand",
    "test:watchAll": "jest --watchAll --runInBand",
    "services:up": "podman compose -f infra/compose.yaml up -d",
    "services:down": "podman compose -f infra/compose.yaml down",
    "services:stop": "podman compose -f infra/compose.yaml stop",
    "services:wait:database": "node infra/scripts/wait_for_postgres.js",
    "migrations:create": "node-pg-migrate create -m infra/migrations",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "lint:spell:check": "cspell \"**\"",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint .",
    "lint:security:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts npm --validate-https",
    "lint:security:secrets": "secretlint \"**/*\"",
    "lint:security:audit": "npm audit --audit-level high --omit=dev",
    "lint:security:sast": "podman run --rm -v \"${PWD}:/src\" docker.io/returntocorp/semgrep semgrep scan --config auto && podman rmi docker.io/returntocorp/semgrep",
    "lint:security:all": "npm run lint:security:lockfile && npm run lint:security:secrets && npm run lint:security:audit",
    "prepare": "husky",
    "commit": "cz"
  },
  "dependencies": {
    "async-retry": "1.3.3",
    "dotenv": "17.3.1",
    "dotenv-expand": "12.0.3",
    "hono": "4.12.10",
    "next": "16.2.1",
    "node-pg-migrate": "8.0.4",
    "pg": "8.20.0",
    "react": "19.2",
    "react-dom": "19.2",
    "swr": "2.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@eslint/css": "1.0.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "1.2.0",
    "@eslint/markdown": "8.0.0",
    "@microsoft/eslint-plugin-sdl": "^1.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.4.1",
    "commitizen": "4.3.1",
    "concurrently": "9.2.1",
    "cspell": "^9.7.0",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.1.0",
    "eslint-config-next": "16.2.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.15.1",
    "eslint-plugin-security": "^4.0.0",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "lint-staged": "^16.4.0",
    "lockfile-lint": "^5.0.0",
    "prettier": "3.8.1",
    "secretlint": "^11.4.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@microsoft/eslint-plugin-sdl": {
      "eslint": "$eslint"
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "package-lock.json": [
      "npm run lint:security:lockfile"
    ],
    "*.{js,ts,jsx,tsx}": [
      "eslint",
      "prettier --check",
      "cspell --no-must-find-files"
    ],
    "*.{js,ts,jsx,tsx,json,md,env,yaml,yml}": [
      "secretlint"
    ],
    "*.{json,md}": [
      "prettier --check",
      "cspell --no-must-find-files"
    ]
  }
}
