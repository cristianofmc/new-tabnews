{
  "name": "new-tabnews",
  "version": "1.0.0",
  "description": "A new implementation for tabnews",
  "homepage": "https://github.com/cristianofmc/new-tabnews#readme",
  "bugs": {
    "url": "https://github.com/cristianofmc/new-tabnews/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cristianofmc/new-tabnews.git"
  },
  "license": "MIT",
  "author": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run wait_for_postgres && npm run migration:up && next dev",
    "services:up": "podman compose -f infra/compose.yaml up -d",
    "services:down": "podman compose -f infra/compose.yaml down",
    "services:stop": "podman compose -f infra/compose.yaml stop",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint .",
    "test": "npm run services:up && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"jest --runInBand --verbose\"",
    "test:watch": "jest --watch --runInBand",
    "test:watchAll": "jest --watchAll --runInBand",
    "migration:create": "node-pg-migrate create -m infra/migrations",
    "migration:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "wait_for_postgres": "node infra/scripts/wait_for_postgres.js",
    "prepare": "husky",
    "commit": "cz"
  },
  "dependencies": {
    "async-retry": "^1.3.3",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "next": "^16.1.6",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.17.2",
    "react": "19.2",
    "react-dom": "19.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/css": "^1.0.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^7.5.1",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "prettier": "^3.8.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
